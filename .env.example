# SIH26078 — Atmospheric Intelligence Environment Configuration
# Copy this file to backend/.env and populate your actual secrets.
# NEVER commit backend/.env to GitHub or expose API keys to the frontend.

# Google Gemini API Key for Meteorological Interpretation Layer
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# IMD (India Meteorological Department) Operational API Credentials (Optional)
IMD_API_KEY=
IMD_AUTH_TOKEN=

# Production CORS Allowed Origins (Comma-separated for multiple origins)
# Example: https://forecast-confidence.vercel.app,https://my-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
